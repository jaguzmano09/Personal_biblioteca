# Server-only settings. Use an anon/publishable key, NEVER service_role or sb_secret_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
GOOGLE_BOOKS_API_KEY=
# Exact origin; HTTPS required outside localhost. Add callback URL in Supabase Auth.
SITE_URL=http://localhost:3000

# Server-only operator details. Set actual values in ignored local env / hosting settings.
# Name and email are shown on the protected data page when both are configured.
# Contact details intended for a published legal notice will be visible to its readers.
TINTERUNA_OPERATOR_NAME=
TINTERUNA_PRIVACY_EMAIL=
TINTERUNA_OPERATOR_CITY=
TINTERUNA_OPERATOR_ADDRESS=
TINTERUNA_OPERATOR_PHONE=
